# porta em que a API sobe (o frontend espera /api nessa porta)
PORT=8000

# conexao com o banco mysql/mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=vmmotors
DB_PASSWORD=vmmotors
DB_NAME=vmmotors

# segredo usado para assinar os tokens JWT (troque em producao)
JWT_SECRET=troque-este-segredo-em-producao
JWT_EXPIRES=7d

# origem liberada no CORS (frontend em dev)
CORS_ORIGIN=http://127.0.0.1:3000
